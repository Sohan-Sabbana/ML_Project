#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""
Stock price prediction with LSTM (AAPL) — CI-friendly version.

Features:
- Robust local CSV loader (lowercase column names handled)
- Automatic fallback when yfinance fails (Jenkins SSL issue)
- Headless plotting (Agg backend) & PNG output
- Configurable EPOCHS, TIME_STEP for fast CI runs
- Works in Jenkins & Google Colab reliably
"""

import os
import math
import numpy as np
import pandas as pd

# Headless plotting for Jenkins
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt

import yfinance as yf
from sklearn.preprocessing import MinMaxScaler
from sklearn.metrics import mean_squared_error

from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Dense, LSTM


# -----------------------------
# 0. Config
# -----------------------------
TICKER = os.getenv("TICKER", "AAPL")
START_DATE = os.getenv("START_DATE", "2015-01-01")
END_DATE = os.getenv("END_DATE", "2024-01-01")
EPOCHS = int(os.getenv("EPOCHS", "5"))       # Small for CI
BATCH_SIZE = int(os.getenv("BATCH_SIZE", "64"))
TIME_STEP = int(os.getenv("TIME_STEP", "100"))
FORECAST_DAYS = int(os.getenv("FORECAST_DAYS", "30"))

PLOT1 = "01_close_history.png"
PLOT2 = "02_predictions.png"
PLOT3 = "03_forecast.png"
METRICS_TXT = "metrics.txt"


# -----------------------------
# CSV Loader that handles lowercase names
# -----------------------------
def read_local_csv(csv_path: str) -> pd.DataFrame:
    """
    Reads AAPL.csv reliably by cleaning/normalizing headers.
    """
    df = pd.read_csv(csv_path)

    # Normalize headers to lowercase
    df.columns = [c.lower() for c in df.columns]

    # --- Fix date column ---
    if "date" not in df.columns:
        raise ValueError("CSV must contain a 'date' column.")
    df["date"] = pd.to_datetime(df["date"], errors="coerce")
    df = df.set_index("date")

    # --- Fix close column ---
    if "close" not in df.columns:
        raise ValueError("CSV must contain a 'close' column.")
    df = df[~df["close"].isna()]

    # Ensure sorted by date
    df = df.sort_index()

    print("DEBUG: CSV Loaded OK. Shape:", df.shape)
    print(df.head())

    return df


# -----------------------------
# Load data (yfinance → fallback to CSV)
# -----------------------------
def load_data(ticker, start, end, csv_path="AAPL.csv"):
    df = None
    try:
        df = yf.download(ticker, start=start, end=end, progress=False)
        if df is None or df.empty:
            raise Exception("Empty data from yfinance.")
    except Exception as e:
        print(f"yfinance failed ({e}), using local CSV '{csv_path}'")
        df = read_local_csv(csv_path)

    return df


# -----------------------------
# Convert series to supervised dataset
# -----------------------------
def create_dataset(dataset, time_step=1):
    dataX, dataY = [], []
    for i in range(len(dataset) - time_step - 1):
        dataX.append(dataset[i:(i + time_step), 0])
        dataY.append(dataset[i + time_step, 0])
    return np.array(dataX), np.array(dataY)


def save_plot(fname, title=None):
    if title:
        plt.title(title)
    plt.tight_layout()
    plt.savefig(fname, bbox_inches="tight", dpi=150)
    plt.close()


# -----------------------------
# 1. Load data
# -----------------------------
df = load_data(TICKER, START_DATE, END_DATE, csv_path="AAPL.csv")

# Use only the Close column
close_series = df["close"].astype(float)

# Plot Close history
plt.figure(figsize=(10, 6))
plt.plot(close_series)
plt.xlabel("Date")
plt.ylabel("Close Price USD ($)")
save_plot(PLOT1, f"{TICKER} Close Price History")


# -----------------------------
# 2. Preprocessing
# -----------------------------
scaler = MinMaxScaler(feature_range=(0, 1))
close_scaled = scaler.fit_transform(np.array(close_series).reshape(-1, 1))

training_size = int(len(close_scaled) * 0.65)
train_data = close_scaled[:training_size]
test_data = close_scaled[training_size:]

# Supervised sequences
X_train, y_train = create_dataset(train_data, TIME_STEP)
X_test, ytest = create_dataset(test_data, TIME_STEP)

# Reshape for LSTM
X_train = X_train.reshape(X_train.shape[0], TIME_STEP, 1)
X_test = X_test.reshape(X_test.shape[0], TIME_STEP, 1)

print("Training Shape:", X_train.shape)
print("Testing  Shape:", X_test.shape)

if len(X_train) == 0:
    raise ValueError(
        f"Not enough rows in CSV to build sequences with TIME_STEP={TIME_STEP}. "
        f"Rows={len(close_series)}"
    )


# -----------------------------
# 3. Build + Train Model
# -----------------------------
model = Sequential([
    LSTM(50, return_sequences=True, input_shape=(TIME_STEP, 1)),
    LSTM(50, return_sequences=True),
    LSTM(50),
    Dense(1)
])

model.compile(loss="mean_squared_error", optimizer="adam")
model.summary()

model.fit(
    X_train,
    y_train,
    validation_data=(X_test, ytest),
    epochs=EPOCHS,
    batch_size=BATCH_SIZE,
    verbose=1
)


# -----------------------------
# 4. Predictions
# -----------------------------
train_pred = model.predict(X_train)
test_pred = model.predict(X_test)

# Reverse scaling
train_pred_inv = scaler.inverse_transform(train_pred)
test_pred_inv = scaler.inverse_transform(test_pred)
y_train_inv = scaler.inverse_transform(y_train.reshape(-1, 1))
ytest_inv = scaler.inverse_transform(ytest.reshape(-1, 1))

# RMSE
train_rmse = math.sqrt(mean_squared_error(y_train_inv, train_pred_inv))
test_rmse = math.sqrt(mean_squared_error(ytest_inv, test_pred_inv))

with open(METRICS_TXT, "w") as f:
    f.write(f"Train_RMSE={train_rmse:.6f}\n")
    f.write(f"Test_RMSE={test_rmse:.6f}\n")

print("Train RMSE:", train_rmse)
print("Test  RMSE:", test_rmse)


# -----------------------------
# 5. Plot Predictions
# -----------------------------
full_len = len(close_scaled)
look_back = TIME_STEP

trainPlot = np.empty((full_len, 1))
trainPlot[:] = np.nan
trainPlot[look_back:look_back + len(train_pred_inv), :] = train_pred_inv

testPlot = np.empty((full_len, 1))
testPlot[:] = np.nan
start = len(train_pred_inv) + look_back * 2 + 1
if start < full_len:
    testPlot[start:start + len(test_pred_inv), :] = test_pred_inv

plt.figure(figsize=(12, 6))
plt.plot(scaler.inverse_transform(close_scaled), label="Original")
plt.plot(trainPlot, label="Train Prediction")
plt.plot(testPlot, label="Test Prediction")
plt.legend()
save_plot(PLOT2, "Predictions vs Actual")


# -----------------------------
# 6. Forecast future
# -----------------------------
x_input = test_data[-TIME_STEP:].reshape(1, -1)
temp_input = x_input.flatten().tolist()
output = []

for _ in range(FORECAST_DAYS):
    x = np.array(temp_input[-TIME_STEP:]).reshape(1, TIME_STEP, 1)
    yhat = model.predict(x, verbose=0)
    temp_input.append(yhat[0][0])
    output.append(yhat[0][0])

history = scaler.inverse_transform(
    np.array(temp_input[:TIME_STEP]).reshape(-1, 1)
)
forecast = scaler.inverse_transform(
    np.array(output).reshape(-1, 1)
)

plt.figure(figsize=(10, 6))
plt.plot(range(1, TIME_STEP + 1), history, label="History")
plt.plot(range(TIME_STEP + 1, TIME_STEP + 1 + FORECAST_DAYS), forecast, label="Forecast")
plt.legend()
save_plot(PLOT3, f"{FORECAST_DAYS}-Day Forecast")

print(f"Saved: {PLOT1}, {PLOT2}, {PLOT3}")
print(f"Metrics saved: {METRICS_TXT}")
